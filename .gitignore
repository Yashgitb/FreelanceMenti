# ============================================================
# ROOT .gitignore — Zapplance Monorepo
# ============================================================

# ─── Large / Backup files ────────────────────────────────────
*.zip
*.tar.gz
*.rar

# ─── Node Modules ────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Environment & Secrets ───────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ─── Build Output ────────────────────────────────────────────
dist/
build/
dist-ssr/
**/dist/
**/build/

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── OS Generated Files ──────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Editor & IDE ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ─── Uploads (runtime files) ─────────────────────────────────
Backend/uploads/
Backend/src/uploads/

# ─── Cache & Misc ────────────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
*.local
*.tsbuildinfo
